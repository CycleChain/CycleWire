{
  "name": "cyclewire",
  "version": "1.0.1",
  "description": "Zero-initial-JS selective activation engine. Turn server-rendered HTML into instant interactivity on intent.",
  "keywords": [
    "resumability",
    "qwik",
    "event-delegation",
    "lazy-loading",
    "progressive-enhancement",
    "server-rendered",
    "html",
    "islands",
    "signals",
    "morph",
    "web-components",
    "shadow-dom",
    "inp",
    "performance",
    "zero-dependency"
  ],
  "homepage": "https://cyclechain.github.io/CycleWire/",
  "bugs": {
    "url": "https://github.com/CycleChain/CycleWire/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CycleChain/CycleWire.git"
  },
  "license": "MIT",
  "author": {
    "name": "CycleChain",
    "email": "fatih.dogancan@cyclechain.io",
    "url": "https://cyclechain.io"
  },
  "type": "module",
  "sideEffects": [
    "./dist/esm/auto.js",
    "./dist/esm-dev/auto.js",
    "./dist/*.global.min.js"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "development": "./dist/esm-dev/index.js",
      "default": "./dist/esm/index.js"
    },
    "./auto": {
      "types": "./types/auto.d.ts",
      "development": "./dist/esm-dev/auto.js",
      "default": "./dist/esm/auto.js"
    },
    "./css": {
      "types": "./types/css.d.ts",
      "development": "./dist/esm-dev/css.js",
      "default": "./dist/esm/css.js"
    },
    "./dom": {
      "types": "./types/dom.d.ts",
      "development": "./dist/esm-dev/dom.js",
      "default": "./dist/esm/dom.js"
    },
    "./morph": {
      "types": "./types/morph.d.ts",
      "development": "./dist/esm-dev/morph.js",
      "default": "./dist/esm/morph.js"
    },
    "./signals": {
      "types": "./types/signals.d.ts",
      "development": "./dist/esm-dev/signals.js",
      "default": "./dist/esm/signals.js"
    },
    "./stream": {
      "types": "./types/stream.d.ts",
      "development": "./dist/esm-dev/stream.js",
      "default": "./dist/esm/stream.js"
    },
    "./bootstrap": {
      "types": "./types/bootstrap.d.ts",
      "development": "./dist/esm-dev/bootstrap.js",
      "default": "./dist/esm/bootstrap.js"
    },
    "./vite": {
      "types": "./tooling/vite.d.ts",
      "default": "./tooling/vite.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cyclewire": "./tooling/bin.js"
  },
  "main": "./dist/esm/index.js",
  "types": "./types/index.d.ts",
  "unpkg": "./dist/cyclewire.global.min.js",
  "jsdelivr": "./dist/cyclewire.global.min.js",
  "files": [
    "dist",
    "types",
    "src",
    "tooling",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.js && tsc -p tsconfig.json && node scripts/types.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:types": "tsc -p test/types/named && tsc -p test/types/plain",
    "typecheck:tooling": "tsc -p tsconfig.tooling.json",
    "test:tooling": "node --test \"test/tooling/**/*.test.js\"",
    "check:es": "node scripts/check-es.js",
    "dev": "node scripts/serve.js",
    "examples": "node examples/build.js",
    "size": "node scripts/size.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --import ./test/unit/setup.js --test \"test/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "prepublishOnly": "npm run build && npm run check:es && npm run size && npm run test:types && npm test"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "acorn": "^8.18.0",
    "datatables.net-dt": "^3.1.2",
    "esbuild": "^0.28.2",
    "flatpickr": "^4.6.13",
    "jquery": "^4.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svelte": "^5.57.1",
    "sweetalert2": "^11.26.25",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vue": "^3.5.43"
  }
}
